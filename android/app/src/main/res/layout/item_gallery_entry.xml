<?xml version="1.0" encoding="utf-8"?>
<com.unblock.app.ui.SquareLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tile_entry"
        android:clipToOutline="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/addIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_import"
            android:src="@drawable/ic_plus" />
    </FrameLayout>
</com.unblock.app.ui.SquareLayout>
