<?xml version="1.0" encoding="utf-8"?>
<com.unblock.app.ui.SquareLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp">

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_thumb"
        android:clipToOutline="true"
        android:contentDescription="@string/cd_result_image"
        android:scaleType="centerCrop" />
</com.unblock.app.ui.SquareLayout>
