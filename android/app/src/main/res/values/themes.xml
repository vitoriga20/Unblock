<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 纯黑白主题：所有强调色都收敛到墨色，避免 Material 默认紫 -->
    <style name="Theme.Unblock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorPrimaryContainer">@color/ink</item>
        <item name="colorOnPrimaryContainer">@color/paper</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/canvas</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorError">@color/destructive</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="alertDialogTheme">@style/Theme.Unblock.Dialog</item>
    </style>

    <style name="Theme.Unblock.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
</resources>
